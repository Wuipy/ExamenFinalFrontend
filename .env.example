# URL the "Reportar fraude" CTAs redirect to.
# Internal route in this app (default):
VITE_REPORTS_URL=/reportar-estafa

# Backend API base URL (no trailing slash).
# Local development:
# VITE_API_URL=http://localhost:5219
#
# Production (Railway / Netlify / etc.) — URL pública HTTPS del backend:
# VITE_API_URL=https://backendexfinalprograiv-production.up.railway.app
# (también puede definirse en .env.production o en variables del hosting)
VITE_API_URL=
