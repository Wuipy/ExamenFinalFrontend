# URL the "Reportar fraude" CTAs redirect to.
# Internal route in this app (default):
VITE_REPORTS_URL=/reportar-estafa

# Backend API base URL (no trailing slash).
# Local development:
# VITE_API_URL=http://localhost:5219
#
# Production (Netlify / Vercel / etc.) — URL pública HTTPS del backend:
# VITE_API_URL=https://tu-api-publica.ejemplo.com
VITE_API_URL=
